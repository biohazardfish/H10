{
  "version": 3,
  "profile": "static_meditation",
  "derived_rr_window": 20,
  "diagnostics": {
    "enabled": true,
    "interval_sec": 1.0
  },
  "mappings": [
    {
      "_comment": "HR BPM -> CC10. Linear 40..180 BPM, slow EMA, suppress unchanged values.",
      "input": "bpm",
      "min": 40,
      "max": 180,
      "mode": "cc",
      "cc": 10,
      "channel": 1,
      "curve": "linear",
      "max_hz": 5,
      "min_change": 1,
      "smoothing": {"type": "ema", "alpha": 0.2}
    },
    {
      "_comment": "RMSSD -> CC11. Linear 5..100 ms, slow moving average, no output until enough RR samples exist.",
      "input": "hrv_rmssd",
      "min": 5,
      "max": 100,
      "mode": "cc",
      "cc": 11,
      "channel": 1,
      "curve": "linear",
      "min_change": 1,
      "smoothing": {"type": "moving_average", "window": 8}
    },
    {
      "_comment": "Each heartbeat -> Note 36 with a short fixed gate.",
      "input": "beat",
      "min": 0,
      "max": 1,
      "mode": "pulse",
      "note": 36,
      "channel": 10,
      "velocity": 80,
      "gate_ms": 80
    },
    {
      "_comment": "Current valid RR interval -> CC14. Linear 400..1500 ms with light smoothing.",
      "input": "rr_ms",
      "min": 400,
      "max": 1500,
      "mode": "cc",
      "cc": 14,
      "channel": 1,
      "curve": "linear",
      "min_change": 1,
      "smoothing": {"type": "ema", "alpha": 0.5}
    }
  ]
}
