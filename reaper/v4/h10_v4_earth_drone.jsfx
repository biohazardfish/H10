desc:H10 V4 Earth Drone
tags:H10 V4 low drone warm organic generator

slider1:0.34<0,1,0.01>Base level
slider2:4<1,12,0.5>Root crossfade (s)

in_pin:none
out_pin:left
out_pin:right

@init
arousal = 0;
regulation = 0.5;
stillness = 1;
scene = 0;
performance_gate = 0;
gate = 0;
warmth = 0.68;
hr_response = 0.65;
hrv_response = 0.6;
bio_depth = 0.8;
fader_earth = 0.58;
root_old = 38;
root_new = 38;
root_fade = 1;
po1 = po2 = po3 = po4 = 0;
pn1 = pn2 = pn3 = pn4 = 0;
lpL1 = lpL2 = lpR1 = lpR2 = 0;
idle_samples = 1000000000;

@slider
base_level = slider1;
root_fade_inc = 1 / max(1, slider2 * srate);

@block
while (midirecv(offset, msg1, msg23)) (
  status = msg1 & $xF0;
  chan = msg1 & $x0F;
  data1 = msg23 & $xFF;
  data2 = (msg23 / 256) & $xFF;
  (chan == 0 || chan == 9) ? idle_samples = 0;

  status == $xB0 && chan == 0 && data1 == 10 ? arousal = data2 / 127;
  status == $xB0 && chan == 0 && data1 == 11 ? regulation = data2 / 127;
  status == $xB0 && chan == 0 && data1 == 17 ? stillness = data2 / 127;
  status == $xB0 && chan == 0 && data1 == 18 ? scene = data2 / 127;
  status == $xB0 && chan == 0 && data1 == 119 ? performance_gate = data2 / 127;

  status == $xB0 && chan == 1 && data1 == 22 ? warmth = data2 / 127;
  status == $xB0 && chan == 1 && data1 == 24 ? hr_response = data2 / 127;
  status == $xB0 && chan == 1 && data1 == 25 ? hrv_response = data2 / 127;
  status == $xB0 && chan == 1 && data1 == 27 ? bio_depth = data2 / 127;
  status == $xB0 && chan == 1 && data1 == 29 ? fader_earth = data2 / 127;

  status == $x90 && chan == 1 && data2 > 0 ? (
    target_root = 36 + (data1 % 12);
    target_root != root_new ? (
      root_old = root_new;
      root_new = target_root;
      root_fade = 0;
    );
  );
  midisend(offset, msg1, msg23);
);

@sample
idle_samples += 1;
idle_samples > srate * 3 ? performance_gate = 0;
gate += (performance_gate - gate) * (performance_gate > gate ? 0.00055 : 0.00008);
root_fade = min(1, root_fade + root_fade_inc);
old_weight = cos(root_fade * $pi * 0.5);
new_weight = sin(root_fade * $pi * 0.5);

freq_old = 440 * exp(log(2) * (root_old - 69) / 12);
freq_new = 440 * exp(log(2) * (root_new - 69) / 12);
memory_norm = min(1, max(0, (scene - 0.74) / 0.26));
memory = memory_norm * memory_norm * (3 - 2 * memory_norm);
hr_open = arousal * hr_response * bio_depth;
hrv_air = regulation * hrv_response * bio_depth;

po1 += 2 * $pi * freq_old * 0.75 / srate;
po2 += 2 * $pi * freq_old / srate;
po3 += 2 * $pi * freq_old * 1.5 / srate;
po4 += 2 * $pi * freq_old * 2.244924 / srate;
pn1 += 2 * $pi * freq_new * 0.75 / srate;
pn2 += 2 * $pi * freq_new / srate;
pn3 += 2 * $pi * freq_new * 1.5 / srate;
pn4 += 2 * $pi * freq_new * 2.244924 / srate;
po1 > 2*$pi ? po1 -= 2*$pi; po2 > 2*$pi ? po2 -= 2*$pi;
po3 > 2*$pi ? po3 -= 2*$pi; po4 > 2*$pi ? po4 -= 2*$pi;
pn1 > 2*$pi ? pn1 -= 2*$pi; pn2 > 2*$pi ? pn2 -= 2*$pi;
pn3 > 2*$pi ? pn3 -= 2*$pi; pn4 > 2*$pi ? pn4 -= 2*$pi;

oldL = sin(po1) * 0.42 + sin(po2) * 0.38 + sin(po3) * (0.12 + hr_open * 0.08) + sin(po4) * memory * 0.08;
oldR = sin(po1 + 0.03) * 0.42 + sin(po2 + 0.08) * 0.38 + sin(po3 + 0.16) * (0.12 + hr_open * 0.08) + sin(po4 + 0.28) * memory * 0.08;
newL = sin(pn1) * 0.42 + sin(pn2) * 0.38 + sin(pn3) * (0.12 + hr_open * 0.08) + sin(pn4) * memory * 0.08;
newR = sin(pn1 + 0.03) * 0.42 + sin(pn2 + 0.08) * 0.38 + sin(pn3 + 0.16) * (0.12 + hr_open * 0.08) + sin(pn4 + 0.28) * memory * 0.08;
rawL = oldL * old_weight + newL * new_weight;
rawR = oldR * old_weight + newR * new_weight;

brightness = (1 - warmth) * 0.65 + hr_open * 0.25 + hrv_air * 0.10;
coef = 0.004 + brightness * 0.034;
lpL1 += coef * (rawL - lpL1); lpL2 += coef * (lpL1 - lpL2);
lpR1 += coef * (rawR - lpR1); lpR2 += coef * (lpR1 - lpR2);
scene_gain = 0.74 - 0.10 * sin(scene * $pi) + memory * 0.08;
still_gain = 0.82 + stillness * 0.18;
level = base_level * fader_earth * scene_gain * still_gain;
spl0 = lpL2 * level * gate;
spl1 = lpR2 * level * gate;
