desc:H10 V4 Heart
tags:H10 V4 heartbeat warm organic generator

slider1:0.48<0,1,0.01>Base level
slider2:54<42,72,0.1>Body frequency (Hz)
slider3:240<100,600,1>Decay (ms)

in_pin:none
out_pin:left
out_pin:right

@init
arousal = 0;
motion = 0;
scene = 0;
performance_gate = 0;
gate = 0;
fader_heart = 0.62;
hr_response = 0.65;
bio_depth = 0.8;
env = 0;
env_low = 0;
phase = 0;
phase_low = 0;
idle_samples = 1000000000;

@slider
base_level = slider1;
body_hz = slider2;
decay_coef = exp(-1 / (max(0.02, slider3 * 0.001) * srate));
low_decay_coef = exp(-1 / (max(0.04, slider3 * 0.0018) * srate));

@block
while (midirecv(offset, msg1, msg23)) (
  status = msg1 & $xF0;
  chan = msg1 & $x0F;
  data1 = msg23 & $xFF;
  data2 = (msg23 / 256) & $xFF;

  (chan == 0 || chan == 9) ? idle_samples = 0;
  status == $xB0 && chan == 0 && data1 == 10 ? arousal = data2 / 127;
  status == $xB0 && chan == 0 && data1 == 12 ? motion = data2 / 127;
  status == $xB0 && chan == 0 && data1 == 18 ? scene = data2 / 127;
  status == $xB0 && chan == 0 && data1 == 119 ? performance_gate = data2 / 127;
  status == $xB0 && chan == 1 && data1 == 24 ? hr_response = data2 / 127;
  status == $xB0 && chan == 1 && data1 == 27 ? bio_depth = data2 / 127;
  status == $xB0 && chan == 1 && data1 == 28 ? fader_heart = data2 / 127;

  status == $x90 && chan == 9 && data1 == 36 && data2 > 0 ? (
    hit = data2 / 127;
    env = max(env, hit);
    env_low = max(env_low, hit * 0.9);
    phase = 0;
    phase_low = 0;
  );
  midisend(offset, msg1, msg23);
);

@sample
idle_samples += 1;
idle_samples > srate * 3 ? performance_gate = 0;
gate += (performance_gate - gate) * (performance_gate > gate ? 0.0012 : 0.00012);

depth_arousal = arousal * (0.25 + 0.75 * hr_response) * bio_depth;
frequency = body_hz + depth_arousal * 7 + motion * 2;
phase += 2 * $pi * frequency / srate;
phase_low += 2 * $pi * frequency * 0.52 / srate;
phase > 2 * $pi ? phase -= 2 * $pi;
phase_low > 2 * $pi ? phase_low -= 2 * $pi;

body = sin(phase) * env;
low = sin(phase_low) * env_low;
soft_transient = body * body * (body >= 0 ? 1 : -1);
scene_level = 0.82 - 0.18 * sin(scene * $pi);
level = base_level * fader_heart * scene_level * (0.8 + depth_arousal * 0.18);
spl0 = (low * 0.62 + body * 0.34 + soft_transient * 0.04) * level * gate;
spl1 = (low * 0.62 + body * 0.33 + soft_transient * 0.035) * level * gate;

env *= decay_coef;
env_low *= low_decay_coef;
